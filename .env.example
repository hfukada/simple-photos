# Public URL of the site (used for the OAuth redirect and cookie security).
BASE_URL=https://photos.example.com
LISTEN_ADDR=127.0.0.1:8080

DATABASE_URL=postgres://photos:CHANGE_ME@localhost:5432/photos?sslmode=disable

# Google OAuth client (Web application). Authorized redirect URI:
#   ${BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in. Leave both empty to allow any Google account.
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
ALLOWED_DOMAINS=

# S3 (or any S3-compatible store: Cloudflare R2, Backblaze B2, Wasabi, MinIO).
S3_BUCKET=my-photos
S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PATH_STYLE=true
# Endpoint browsers use for photo URLs, if different from S3_ENDPOINT
# (e.g. self-hosted MinIO behind Caddy).
# S3_PUBLIC_ENDPOINT=https://s3.photos.example.com
S3_PREFIX=
# Install a 31-day expiry rule on the bucket at startup. REPLACES any existing
# lifecycle rules -- only use on a bucket dedicated to this app.
S3_MANAGE_LIFECYCLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
