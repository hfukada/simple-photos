# Copy to .env (docker compose reads it automatically) and fill in.
# Generate secrets with: openssl rand -hex 24

POSTGRES_PASSWORD=
# POSTGRES_PORT=5432   # host port; change if the host already runs Postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Access key the app uses (created by minio-init with bucket-only rights).
S3_ACCESS_KEY=simple-photos
S3_SECRET_KEY=
S3_BUCKET=photos

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=you@gmail.com

# Production (behind deploy/Caddyfile):
BASE_URL=https://sasoshi.party
S3_PUBLIC_ENDPOINT=https://s3.sasoshi.party
# Local testing instead:
# BASE_URL=http://localhost:8080
# S3_PUBLIC_ENDPOINT=http://localhost:9000
